# ================================
# ParkEase — Monorepo .gitignore
# ================================

# ================================
# Dependencies
# ================================
node_modules/
**/node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# ================================
# Environment Variables
# ================================
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
**/.env
**/.env.local
**/.env.production

# ================================
# Build Outputs
# ================================
/build
/dist
**/build/
**/dist/
client/build/
client/dist/
frontend/build/
frontend/dist/
vendor-frontend/build/
vendor-frontend/dist/

# ================================
# Logs
# ================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
**/logs/
**/**.log

# ================================
# Runtime / Process
# ================================
pids/
*.pid
*.seed
*.pid.lock

# ================================
# Coverage and Testing
# ================================
coverage/
**/coverage/
*.lcov
.nyc_output/
/test-results/
/playwright-report/
/playwright/.cache/

# ================================
# Cache
# ================================
.cache/
**/.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
.npm/
.yarn-integrity

# ================================
# OS Generated Files
# ================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.AppleDouble
.LSOverride
Icon?

# Windows
desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ================================
# Editor and IDE
# ================================

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains (WebStorm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr
out/

# Vim
*.swp
*.swo
*~
Session.vim
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project

# ================================
# MongoDB
# ================================
*.mongodb
mongo-data/
data/db/

# ================================
# Uploads and Media
# ================================
uploads/
**/uploads/
public/uploads/
temp/
**/temp/
tmp/
**/tmp/

# ================================
# SSL / Certificates
# ================================
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx

# ================================
# Package Manager Locks
# (keep package-lock.json or yarn.lock — pick one)
# ================================
# Uncomment whichever you are NOT using:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ================================
# Miscellaneous
# ================================
*.zip
*.tar.gz
*.rar
.vercel
.netlify
.railway